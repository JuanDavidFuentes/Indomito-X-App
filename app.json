{
  "expo": {
    "name": "Indómito X",
    "slug": "indomitox",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "indomitox",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "co.indomitox.app",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:indomitox.co",
        "applinks:www.indomitox.co"
      ]
    },
    "android": {
      "package": "co.indomitox.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1120",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "indomitox.co",
              "pathPrefix": "/es/"
            },
            {
              "scheme": "https",
              "host": "indomitox.co",
              "pathPrefix": "/en/"
            },
            {
              "scheme": "https",
              "host": "indomitox.co",
              "pathPrefix": "/fr/"
            },
            {
              "scheme": "https",
              "host": "www.indomitox.co",
              "pathPrefix": "/es/"
            },
            {
              "scheme": "https",
              "host": "www.indomitox.co",
              "pathPrefix": "/en/"
            },
            {
              "scheme": "https",
              "host": "www.indomitox.co",
              "pathPrefix": "/fr/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1120",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0B1120",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Indómito X usa tu ubicación solo cuando tocas «Cerca de mí», para mostrarte las aventuras cercanas.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
