# Indómito X — app. Copia este archivo a `.env` si necesitas cambiar las URLs.
# Desde el emulador de Android, "localhost" del PC es 10.0.2.2 (es el valor por defecto).
# En un teléfono real, usa la IP del PC en la red Wi-Fi (p. ej. http://192.168.1.20:4000).
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:3000
